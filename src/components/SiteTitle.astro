---
// Overrides Starlight's SiteTitle to add a small subtitle under the site
// name in the nav header, since a single line of "TA Software FU Wiki"
// read as a bit bare on its own.
import { logos } from 'virtual:starlight/user-images';
import config from 'virtual:starlight/user-config';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const SUBTITLE = 'Documentation Hub';
---

<a href={siteTitleHref} class="site-title sl-flex">
	{
		config.logo && logos.dark && (
			<>
				<img
					class:list={{ 'light:sl-hidden print:hidden': !('src' in config.logo) }}
					alt={config.logo.alt}
					src={logos.dark.src}
					width={logos.dark.width}
					height={logos.dark.height}
				/>
				{!('src' in config.logo) && (
					<img
						class="dark:sl-hidden print:block"
						alt={config.logo.alt}
						src={logos.light?.src}
						width={logos.light?.width}
						height={logos.light?.height}
					/>
				)}
			</>
		)
	}
	<span class="title-stack">
		<span class:list={{ 'title-main': true, 'sr-only': config.logo?.replacesTitle }} translate="no">
			{siteTitle}
		</span>
		<span class="title-sub">{SUBTITLE}</span>
	</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		.title-stack {
			display: flex;
			flex-direction: column;
			justify-content: center;
			gap: 0.05rem;
			overflow: hidden;
			line-height: 1.15;
		}
		.title-main {
			font-size: var(--sl-text-lg);
			font-weight: 600;
			color: var(--sl-color-text-accent);
		}
		.title-sub {
			font-size: 0.6875rem;
			font-weight: 500;
			color: var(--sl-color-gray-3);
			letter-spacing: 0.03em;
			text-transform: uppercase;
		}
		img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			max-width: 100%;
			object-fit: contain;
			object-position: 0 50%;
		}
	}
</style>
